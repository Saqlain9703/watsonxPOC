# Copy to .env. Keep credentials out of agent YAML and version control.
# Values are read as dotenv data, never executed as shell commands.

# Required for importing/deploying to the existing watsonx Orchestrate tenant.
# Copy the exact service instance URL from Settings > API details.
WO_INSTANCE_URL="<your-service-instance-url>"
WO_API_KEY="<your-orchestrate-api-key>"
WO_ENV_NAME="poc-saas"
# ibm_iam for IBM Cloud; mcsp, mcsp_v1, or mcsp_v2 for AWS SaaS.
WO_ENV_TYPE="ibm_iam"
# Use the full provider/model ID returned by `make models` for this tenant.
# Choose a chat model with native function calling and react_core support.
WO_AGENT_MODEL="<supported-provider/model-id>"

# Optional Developer Edition (not needed for the SaaS path).
WO_DEVELOPER_EDITION_SOURCE="myibm"
WO_ENTITLEMENT_KEY="<your-entitlement-key>"

# Later phases: watsonx.ai evaluation and embeddings.
WATSONX_APIKEY="<your-watsonx-ai-api-key>"
WATSONX_URL="<your-watsonx-ai-service-url>"
WATSONX_PROJECT_ID="<your-watsonx-ai-project-id>"
WATSONX_SPACE_ID="<your-watsonx-ai-space-id>"

# Later phases: watsonx.governance.
WXG_SERVICE_URL="<your-governance-service-url>"
WXG_API_KEY="<your-governance-api-key>"
WXG_USE_CASE_ID="<your-governance-use-case-id>"
